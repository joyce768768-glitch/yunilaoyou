{
  "name": "与你老友 Design Tokens",
  "layer": "primitive",
  "version": "1.0.0",
  "source": "index.html, website/*.html, setkey.html",
  "anchors": "已声明 30 个变量全部保留原名原值",
  "tokens": {
    "primary":  { "softer": "#F5F3FF", "soft": "#ECE8FF", "200": "#C4B8F0", "300": "#8478FF", "base": "#6C5CE7", "600": "#5647D6", "deep": "#4B42C6", "800": "#3D2F80" },
    "ink":      { "night": "#1E1940", "deep": "#262050", "base": "#302C63", "2": "#6D69A4", "3": "#A9A5CD", "4": "#B9B4D8" },
    "coral":    { "soft": "#FFEAE1", "light": "#FF9A76", "base": "#FA7550", "deep": "#D9683A" },
    "mint":     { "soft": "#DEF5EC", "light": "#63E2B6", "base": "#2BBE94", "deep": "#1E9A74" },
    "pink":     { "soft": "#FFE6EF", "light": "#F5A8C0", "base": "#FF8FB8", "deep": "#F25C82" },
    "sky":      { "soft": "#E3F1FD", "light": "#7CC8F5", "base": "#4AA8E8", "deep": "#2E86C8" },
    "sun":      { "soft": "#FFF3D6", "softer": "#FFF7EA", "light": "#FFD98F", "base": "#FBB03B", "deep": "#F0B24C" },
    "surface":  { "bg": "#FAF6EF", "base": "#FFFFFF", "2": "#F5F1E8", "line": "#EFE9DD", "hairline": "rgba(48,44,99,.07)" }
  },
  "typography": {
    "family": { "disp": "阿里妈妈方圆体 VF", "body": "system", "num": "Baloo 2" },
    "scale": { "xs": 10.5, "sm": 11.5, "base": 12.5, "md": 13.5, "num": 14.5, "lg": 15, "xl": 19, "2xl": 22 }
  },
  "radius": { "xs": 8, "s": 10, "m": 12, "l": 14, "xl": 18, "pill": 999, "circle": "50%" },
  "shadow": { "s": "--sh-s", "m": "--sh-m", "l": "--sh-l", "inset": "--sh-inset" },
  "motion": { "ease": "cubic-bezier(.32,.72,.24,1)", "spring": "cubic-bezier(.34,1.56,.64,1)", "dur": { "fast": 0.15, "base": 0.2, "slow": 0.3, "lazy": 0.5 } },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 40], "status": "proposed-待页面校验" },
  "mergeMap": {
    "#f0eeff": "primary-soft", "#e8e4ff": "primary-soft", "#f9eeff": "primary-soft",
    "#8478ff": "primary-300", "#9183ff": "primary-300", "#7a6bff": "primary-300", "#a7a3f5": "primary-300",
    "#5a4bd8": "primary-600", "#5343d4": "primary-600",
    "#4b42c8": "primary-deep (原笔误)", "#4738bc": "primary-deep",
    "#a5a1c7": "ink-3", "#6b67a0": "ink-2", "#2a2355": "ink-deep",
    "#ffb930": "sun (重点合并项: 8处)", "#ffd08a": "sun-light", "#f5d98f": "sun-light", "#e0b24c": "sun-deep", "#fff7ea": "sun-softer",
    "#ff9a68": "coral-light", "#ff9a5c": "coral-light", "#ff6b4a": "coral-deep", "#d14a28": "coral-deep", "#ffede6": "coral-soft",
    "#f26d85": "pink-deep", "#e87ba0": "pink-deep", "#e85d96": "pink-deep", "#ffe3ef": "pink-soft",
    "#2fc79a": "mint", "#1fa983": "mint-deep", "#ddf9ee": "mint-soft", "#e8f8f3": "mint-soft",
    "#4a9de0": "sky", "#5eb6e8": "sky-light", "#2e86b8": "sky-deep", "#e4f3fd": "sky-soft",
    "#f0ebe0": "surface-2", "#f3eee6": "surface-2",
    "v1.8.0": {
      "#ffefe0": "coral-soft", "#e7e3ff": "primary-soft", "#e2f5ee": "mint-soft",
      "#fff3e6": "coral-soft", "#f7f1e6": "sun-soft", "#d9d2f0": "primary-soft",
      "#7a6bff": "primary-300 (grad-progress stop)", "#494170": "ink-frame (新档)",
      "#ff9dc0": "pink-bright (新档)", "#c192f5": "primary-violet (新档)", "#b47716": "sun-dark (新档)",
      "#fff7ea": "sun-softer", "#ffb930": "sun", "#ff8fb8": "pink", "#262050": "ink-deep", "#1e1940": "ink-night",
      "#8a5ac8": "primary (皇冠图标吸附)", "#7a58c0": "primary (箭头图标吸附)", "#e89b00": "sun (喇叭图标吸附)",
      "#e85d96": "pink-deep", "#1fa983": "mint-deep", "#9183ff": "primary-300", "#5343d4": "primary-600",
      "#eef0ff": "primary-softer", "#f6f0ff": "primary-soft", "#eefaff": "sky-soft",
      "#3a3f6e": "ink", "#8b90b8": "ink-2", "#dcdff5": "primary-200", "#f8f9ff": "primary-softer",
      "#8f9bf5": "primary-300", "#2e9e56": "status-success (semantic)",
      "#8a85b5": "ink-2 (admin st.ban)", "#efedf8": "primary-softer (admin st.ban 底)",
      "#ffc98f": "sun-light (admin alt 柱)", "#fff": "text-invert/surface (admin)"
    }
  },
  "fontSizeMap": { "10": "xs", "11": "sm", "11.5": "sm", "12": "base", "12.5": "base", "13": "md", "13.5": "md", "14": "num", "14.5": "num", "15": "lg", "19": "xl", "22": "2xl", "9": "xs⚠人工确认", "9.5": "xs⚠人工确认" },
  "durationMap": { "0.15": "fast", "0.16": "fast", "0.18": "fast", "0.2": "base", "0.25": "slow", "0.28": "slow", "0.3": "slow", "0.5": "lazy" },
  "fixedBugs": [
    "--r-m 被引用 18 次但从未定义 → 已定义为 12px",
    "--r-l 被引用 4 次但从未定义 → 已定义为 14px"
  ]
}
